{% extends 'layouts/base.twig' %}

{% block title %}{{ config('app.name') }} — service desk{% endblock %}

{% block content %}
<section class="intro">
    <p class="eyebrow">Service desk</p>
    <h1>Requests, not WhatsApp scrollback.</h1>
    <p class="lede">
        Every request gets an owner, a deadline and a history. The person reporting it
        never needs an account.
    </p>
    <p class="actions">
        <a class="button" href="{{ route('register') }}">Create a workspace</a>
        <a class="button button-quiet" href="{{ route('login') }}">Sign in</a>
    </p>
    <p class="note">Workspace access is by invitation from your administrator.</p>
</section>
{% endblock %}
