{% extends 'mail/layout.twig' %}

{% block content %}
    <p style="margin:0 0 12px;">Hello {{ requester_name }},</p>
    <p style="margin:0 0 12px;">{{ author_name }} replied to your request <strong>{{ reference }}</strong> — {{ subject }}.</p>
    <div style="margin:0 0 16px;padding:12px 14px;border-left:3px solid #14532d;background:#e3ece5;white-space:pre-line;">{{ body }}</div>
    <p style="margin:0 0 16px;">You can reply or follow progress through your tracking link.</p>
    <p style="margin:0;font-size:13px;"><a href="{{ tracking_url }}">{{ tracking_url }}</a></p>
{% endblock %}
