{% extends 'layouts/base.twig' %}

{% block title %}Too many requests — {{ config('app.name') }}{% endblock %}

{% block content %}
<section class="intro">
    <p class="eyebrow">429</p>
    <h1>Too many requests</h1>
    <p class="lede">{{ message ?: 'Wait a moment, then try again.' }}</p>
    <p class="note"><a href="{{ route('home') }}">Return to the start page</a></p>
</section>
{% endblock %}
