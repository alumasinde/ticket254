{% extends 'layouts/app.twig' %}

{% block title %}Audit log — {{ workspace.name }}{% endblock %}

{% block content %}
<div class="page-head">
    <div>
        <p class="eyebrow">Security</p>
        <h1 class="page-title">Audit log</h1>
        <p class="page-lede">An append-only record of changes staff made in this workspace. Passwords and tokens are never stored here.</p>
    </div>
</div>

<form class="filters audit-filters" method="get" action="{{ route('audit.index') }}">
    <div class="filters-row audit-row">
        <div class="field">
            <label for="action">Action</label>
            <select id="action" name="action">
                <option value="">All actions</option>
                {% for action in actions %}
                    <option value="{{ action }}"{{ filters.action == action ? ' selected' : '' }}>{{ action }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="field">
            <label for="from">From</label>
            <input id="from" name="from" type="date" value="{{ filters.from }}">
        </div>
        <div class="field">
            <label for="to">To</label>
            <input id="to" name="to" type="date" value="{{ filters.to }}">
        </div>
        <div class="filter-actions">
            <button class="button" type="submit">Filter</button>
            <a class="button button-quiet" href="{{ route('audit.index') }}">Reset</a>
        </div>
    </div>
</form>

{% if rows %}
    <div class="audit-list">
        {% for row in rows %}
            <article class="panel audit-entry">
                <div class="audit-entry-head">
                    <div>
                        <p class="audit-action">{{ row.action }}</p>
                        <p class="audit-actor">
                            {{ row.actor ? row.actor.name : 'System' }}
                            · {{ row.created_at ? row.created_at|date('j M Y, H:i:s', workspace.timezone) : '—' }}
                        </p>
                    </div>
                    <span class="tag">{{ row.resource_type }}{% if row.resource_id %} #{{ row.resource_id }}{% endif %}</span>
                </div>

                {% if row.metadata %}
                    <pre class="audit-meta">{{ row.metadata|json_encode }}</pre>
                {% endif %}

                <p class="audit-source">
                    {% if row.ip_address %}{{ row.ip_address }}{% endif %}
                    {% if row.user_agent %}<span title="{{ row.user_agent }}">{{ row.user_agent|slice(0, 70) }}{{ row.user_agent|length > 70 ? '…' : '' }}</span>{% endif %}
                </p>
            </article>
        {% endfor %}
    </div>

    {% if meta.total_pages > 1 %}
        <nav class="pagination" aria-label="Audit pages">
            <span class="muted">{{ meta.total }} entries · page {{ meta.page }} of {{ meta.total_pages }}</span>
            {% if meta.page > 1 %}
                <a class="button button-quiet" href="{{ route('audit.index', {action: filters.action, from: filters.from, to: filters.to, page: meta.page - 1}) }}">Previous</a>
            {% endif %}
            {% if meta.page < meta.total_pages %}
                <a class="button button-quiet" href="{{ route('audit.index', {action: filters.action, from: filters.from, to: filters.to, page: meta.page + 1}) }}">Next</a>
            {% endif %}
        </nav>
    {% endif %}
{% else %}
    <div class="empty-state">
        <h2>No audit entries</h2>
        <p class="muted">Changes to members, teams, settings and tickets will appear here.</p>
    </div>
{% endif %}
{% endblock %}
