{% extends 'layouts/app.twig' %}

{% block title %}Workspace — {{ workspace.name }}{% endblock %}

{% block content %}
<div class="page-head">
    <div>
        <p class="eyebrow">Workspace</p>
        <h1 class="page-title">Operations</h1>
        <p class="page-lede">Requests, routing and the teams that handle them for {{ workspace.name }}.</p>
    </div>
    <a class="button" href="{{ route('tickets.create') }}">New ticket</a>
</div>

<section class="panel queue-callout">
    <div>
        <h2>Ticket queue</h2>
        <p class="muted">Every request in this workspace, filtered by status, team, assignee and due date.</p>
    </div>
    <a class="button button-quiet" href="{{ route('tickets.index') }}">Open tickets</a>
</section>

<div class="grid-2">
    <section class="panel">
        <h2>Teams · {{ teams|length }}</h2>
        {% if teams %}
            <ul class="data-list">
                {% for team in teams %}
                    <li><span>{{ team.name }}</span><span class="tag">{{ team.status }}</span></li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="muted">No teams yet.</p>
        {% endif %}
    </section>

    <section class="panel">
        <h2>Categories · {{ categories|length }}</h2>
        {% if categories %}
            <ul class="data-list">
                {% for category in categories %}
                    <li><span>{{ category.name }}</span><span class="tag">{{ category.status }}</span></li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="muted">No categories yet.</p>
        {% endif %}
    </section>
</div>

<p class="app-session">
    Signed in as {{ user.first_name }} {{ user.last_name }} · {{ role|capitalize }} · {{ workspace.timezone }}
</p>
{% endblock %}
