{% extends 'layouts/base.twig' %}

{% block body_class %}app-body{% endblock %}

{% block header %}
<header class="app-bar">
    <div class="app-bar-inner">
        <div class="app-brand">
            <a class="wordmark" href="{{ route('app.home') }}">{{ config('app.name') }}</a>
            <span class="workspace-name">{{ workspace.name }}</span>
        </div>

        <nav class="app-nav" aria-label="Workspace">
            <a href="{{ route('app.home') }}"{{ nav == 'workspace' ? ' aria-current="page"' : '' }}>Dashboard</a>
            <a href="{{ route('tickets.index') }}"{{ nav == 'tickets' ? ' aria-current="page"' : '' }}>Tickets</a>
            {% if can('teams.manage') %}
                <a href="{{ route('teams.index') }}"{{ nav == 'teams' ? ' aria-current="page"' : '' }}>Teams</a>
            {% endif %}
            {% if can('members.manage') %}
                <a href="{{ route('members.index') }}"{{ nav == 'members' ? ' aria-current="page"' : '' }}>Members</a>
            {% endif %}
            {% if can('categories.manage') %}
                <a href="{{ route('categories.index') }}"{{ nav == 'categories' ? ' aria-current="page"' : '' }}>Categories</a>
            {% endif %}
            {% if can('audit.view') %}
                <a href="{{ route('audit.index') }}"{{ nav == 'audit' ? ' aria-current="page"' : '' }}>Audit</a>
            {% endif %}
            {% if can('settings.manage') %}
                <a href="{{ route('settings.show') }}"{{ nav == 'settings' ? ' aria-current="page"' : '' }}>Settings</a>
            {% endif %}
        </nav>

        <div class="app-user">
            <span class="app-user-name">{{ user.first_name }} {{ user.last_name }}</span>
            <form method="post" action="{{ route('logout') }}">
                {{ csrf_field() }}
                <button class="link-button" type="submit">Sign out</button>
            </form>
        </div>
    </div>
</header>
{% endblock %}

{% block main_class %}app-main{% endblock %}
