<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="{{ csrf_token() }}">
    <title>{% block title %}{{ config('app.name') }}{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('assets/css/tokens.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/base.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/components.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/public.css') }}">
    {% block styles %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    {% block header %}
    <header class="site-header">
        <a class="wordmark" href="{{ route('home') }}">{{ config('app.name') }}</a>
    </header>
    {% endblock %}

    <main class="{% block main_class %}site-main{% endblock %}">
        {% set success = flash('success') %}
        {% set failure = flash('error') %}
        {% if success %}
            <p class="flash flash-success" role="status">{{ success }}</p>
        {% endif %}
        {% if failure %}
            <p class="flash flash-error" role="alert">{{ failure }}</p>
        {% endif %}

        {% block content %}{% endblock %}
    </main>

    {% block scripts %}{% endblock %}
</body>
</html>
