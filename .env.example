APP_NAME=HudumaDesk
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8099

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hudumadesk_dev
DB_USER=
DB_PASS=

SESSION_NAME=hd_session
SESSION_LIFETIME=120
SESSION_ABSOLUTE_LIFETIME=720
SESSION_SECURE=false

# Enable only when the site is served over HTTPS.
SECURITY_HSTS=false

BACKUP_RETAIN_DAYS=14
# Leave empty to autodetect XAMPP on Windows, then PATH.
MYSQLDUMP_BIN=
MYSQL_BIN=

LOG_LEVEL=debug

MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=

UPLOAD_MAX_MB=5
